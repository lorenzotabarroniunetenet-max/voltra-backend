generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRADER
  ADMIN
}

enum Phase {
  CHALLENGE
  VERIFICATION
  FUNDED
  INSTANT
}

enum DrawdownType {
  STATIC
  TRAILING
}

enum AccountStatus {
  ACTIVE
  PASSED
  FAILED
  PAID_OUT
}

enum CryptoNetwork {
  USDT_TRC20
  USDT_ERC20
  USDC_ERC20
  USDC_SOLANA
  BTC
  ETH
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  passwordHash      String
  name              String
  role              Role         @default(TRADER)
  emailVerified     Boolean      @default(false)
  emailVerifyToken  String?      @unique
  approved          Boolean      @default(false)
  approvedAt        DateTime?
  resetToken        String?      @unique
  resetTokenExpiry  DateTime?
  telegramChatId    String?
  kycVerifiedAt     DateTime?
  notes             String?
  plan              String       @default("FREE")
  rank              String       @default("Caporale")
  matricola         String?      @unique
  enlistedAt        DateTime?
  pendingCeremonyId String?
  totpSecret        String?
  totpEnabled       Boolean      @default(false)
  totpBackupCodes   String?
  email2faEnabled   Boolean      @default(false)
  email2faCode      String?
  email2faExpiry    DateTime?
  email2faNudgeOff  Boolean      @default(false)
  showInAlbo        Boolean      @default(true)
  purchaseCount     Int          @default(0)
  memberNumber      Int?         @unique
  oathDone          Boolean      @default(false)
  walletAddress     String?
  membershipTokenId String?
  membershipTxHash  String?
  tradeLogs         TradeLog[]   @relation("userTradeLogs")
  createdAt         DateTime     @default(now())
  propAccounts      PropAccount[]
  payoutRequests    PayoutRequest[]
  auditLogsActor    AuditLog[]   @relation("actor")
  decorations       DecorationAward[]
  serviceLog        ServiceLogEntry[]
  notifications     Notification[]
  ceremonies        Ceremony[]
  documents         Document[]
  orders            Order[]      @relation("userOrders")
  telegramLinkTokens   TelegramLinkToken[]
  tickets              SupportTicket[]
  supportConversations SupportConversation[]
  supportRatings       SupportRating[]
  aiUsage              AIUsage[]
  subscriptions        Subscription[]
  enrolledAt           DateTime?
}

model Document {
  id          String   @id @default(cuid())
  userId      String
  category    String   @default("contract")
  title       String
  description String?  @db.Text
  fileUrl     String?
  signed      Boolean  @default(false)
  signedAt    DateTime?
  uploadedAt  DateTime @default(now())
  uploadedBy  String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?   @db.Text
  discountType  String    @default("percent")  // "percent" o "fixed"
  discountValue Decimal   @db.Decimal(10,2)
  maxUses       Int?
  usedCount     Int       @default(0)
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  active        Boolean   @default(true)
  programId     String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  redemptions   CouponRedemption[]
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  userId     String
  programId  String?
  amountOff  Decimal? @db.Decimal(10,2)
  redeemedAt DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
}

model Briefing {
  id          String   @id @default(cuid())
  number      Int      @unique @default(autoincrement())
  type        String   @default("ordine_del_giorno")
  title       String
  body        String   @db.Text
  pinned      Boolean  @default(false)
  publishedAt DateTime @default(now())
  authorId    String?
  createdAt   DateTime @default(now())
}

model Decoration {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  criterion   String   @db.Text
  iconKey     String   @default("medal")
  rarity      String   @default("common")
  autoTrigger String?
  createdAt   DateTime @default(now())
  awards      DecorationAward[]
}

model DecorationAward {
  id           String     @id @default(cuid())
  decorationId String
  userId       String
  awardedAt    DateTime   @default(now())
  reason       String?    @db.Text
  decoration   Decoration @relation(fields: [decorationId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([decorationId, userId])
}

model ServiceLogEntry {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String?  @db.Text
  iconKey     String   @default("star")
  occurredAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?  @db.Text
  url       String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradeLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("userTradeLogs", fields: [userId], references: [id], onDelete: Cascade)
  type      String   // 'W' | 'L'
  note      String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Ceremony {
  id              String    @id @default(cuid())
  userId          String
  type            String
  payload         Json
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Program {
  id                    String       @id @default(cuid())
  name                  String
  accountSize           Decimal      @db.Decimal(14,2)
  phase                 Phase
  profitTargetPct       Decimal?     @db.Decimal(5,2)
  maxDailyLossPct       Decimal      @db.Decimal(5,2)
  maxOverallLossPct     Decimal      @db.Decimal(5,2)
  minTradingDays        Int?
  consistencyBestDayPct Decimal?     @db.Decimal(5,2)
  profitSplitPct        Decimal      @db.Decimal(5,2)
  drawdownType          DrawdownType @default(STATIC)
  scalpingAllowed       Boolean      @default(true)
  newsAllowed           Boolean      @default(true)
  weekendHoldAllowed    Boolean      @default(true)
  payoutFrequencyDays   Int          @default(7)
  priceUsd              Decimal?     @db.Decimal(14,2)
  activationFeeUsd      Decimal?     @db.Decimal(14,2)
  active                Boolean      @default(true)
  createdAt             DateTime     @default(now())
  accounts              PropAccount[]
}

model PropAccount {
  id            String        @id @default(cuid())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  program       Program       @relation(fields: [programId], references: [id])
  programId     String
  brokerLogin   String
  broker        String        @default("cTrader")
  startBalance  Decimal       @db.Decimal(14,2)
  status        AccountStatus @default(ACTIVE)
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  failureReason String?
  notes         String?
  snapshots     DailySnapshot[]
  payoutRequests PayoutRequest[]
  @@index([userId, status])
  @@index([status, startedAt])
}

model DailySnapshot {
  id            String      @id @default(cuid())
  account       PropAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String
  date          DateTime    @db.Date
  balance       Decimal     @db.Decimal(14,2)
  equity        Decimal     @db.Decimal(14,2)
  trades        Int?
  volume        Decimal?    @db.Decimal(18,2)
  bestTrade     Decimal?    @db.Decimal(14,2)
  worstTrade    Decimal?    @db.Decimal(14,2)
  avgWin        Decimal?    @db.Decimal(14,2)
  avgLoss       Decimal?    @db.Decimal(14,2)
  winRatePct    Decimal?    @db.Decimal(5,2)
  profitFactor  Decimal?    @db.Decimal(8,4)
  dailyPL       Decimal     @db.Decimal(14,2)
  drawdownPct   Decimal     @db.Decimal(5,2)
  notes         String?
  enteredBy     String
  createdAt     DateTime    @default(now())
  @@unique([accountId, date])
  @@index([accountId, date(sort: Desc)])
}

model PayoutRequest {
  id              String        @id @default(cuid())
  account         PropAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId       String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  amountUsd       Decimal       @db.Decimal(14,2)
  cryptoNetwork   CryptoNetwork
  cryptoAddress   String
  status          PayoutStatus  @default(PENDING)
  rejectionReason String?
  txHash          String?
  receiptUrl      String?
  requestedAt     DateTime      @default(now())
  processedAt     DateTime?
  @@index([status, requestedAt])
  @@index([userId, requestedAt(sort: Desc)])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     User     @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  actorId   String
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([actorId, createdAt(sort: Desc)])
}

model Setting {
  key       String   @id
  value     String
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Order {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation("userOrders", fields: [userId], references: [id], onDelete: Cascade)
  programId     String
  programName   String
  amount        Float
  currency      String       @default("USDT")
  network       String?
  txHash        String?
  receiptUrl    String?
  couponCode    String?
  missionTokenId String?
  missionTxHash  String?
  status        OrderStatus  @default(PENDING)
  approvalToken String?      @unique
  createdAt     DateTime     @default(now())
  decidedAt     DateTime?
  decidedBy     String?
  rejectionReason String?
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
}

model TelegramLinkToken {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  @@index([userId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  subject   String
  message   String   @db.Text
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SupportConversation {
  id             String                    @id @default(cuid())
  userId         String
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         SupportConvStatus         @default(OPEN)
  unreadByAdmin  Int                       @default(0)
  unreadByMember Int                       @default(0)
  lastMessageAt  DateTime                  @default(now())
  openedAt       DateTime                  @default(now())
  closedAt       DateTime?
  closedByChatId String?
  messages       SupportMessage[]
  rating         SupportRating?
  @@index([status])
  @@index([userId, status])
  @@index([lastMessageAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     SupportSenderRole
  senderChatId   String?
  body           String              @db.Text
  aiSummary      String?             @db.Text
  createdAt      DateTime            @default(now())
  @@index([conversationId, createdAt])
}

model SupportRating {
  id             String              @id @default(cuid())
  conversationId String              @unique
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  score          Int
  createdAt      DateTime            @default(now())
  @@index([userId])
}

model AIUsage {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  count  Int      @default(0)
  @@unique([userId, date])
  @@index([date])
}

model BotKvStore {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

enum SupportConvStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SupportSenderRole {
  MEMBER
  ADMIN
  AI
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime
  amount    Decimal            @default(99) @db.Decimal(10,2)
  currency  String             @default("EUR")
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
  @@index([endDate])
  @@index([status])
}
