generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  MASTER
  SLAVE
}

enum AccountRole {
  BROKER
  PROP
}

enum AccountStatus {
  ACTIVE
  PAUSED
  DISCONNECTED
  PROVISIONING
}

enum RuleStatus {
  ACTIVE
  PAUSED
}

enum LotMode {
  MULTIPLIER
  FIXED
  PROPORTIONAL
}

enum OverrideMode {
  COPY
  OVERRIDE
  DISABLED
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  ERROR
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  passwordHash      String
  name              String
  role              Role         @default(USER)
  emailVerified     Boolean      @default(false)
  emailVerifyToken  String?      @unique
  plan              String       @default("FREE")
  createdAt         DateTime     @default(now())
  accounts          Mt5Account[]
  rules             CopyRule[]
}

model Mt5Account {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String
  type             AccountType
  accountRole      AccountRole   @default(BROKER)
  broker           String
  server           String
  login            String
  passwordEnc      String
  metaapiAccountId String?
  metaapiState     String?
  balance          Float         @default(0)
  equity           Float         @default(0)
  startingBalance  Float         @default(0)
  currency         String        @default("USD")
  leverage         Int           @default(100)
  status           AccountStatus @default(PROVISIONING)
  lastSync         DateTime?
  createdAt        DateTime      @default(now())
  rulesAsMaster    CopyRule[]    @relation("MasterRules")
  rulesAsSlave     CopyRule[]    @relation("SlaveRules")

  @@unique([userId, login, server])
}

model CopyRule {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterAccountId String
  master          Mt5Account   @relation("MasterRules", fields: [masterAccountId], references: [id], onDelete: Cascade)
  slaveAccountId  String
  slave           Mt5Account   @relation("SlaveRules", fields: [slaveAccountId], references: [id], onDelete: Cascade)
  label           String
  reverse         Boolean      @default(false)
  lotMode         LotMode      @default(MULTIPLIER)
  lotValue        Float        @default(1.0)
  tpMode          OverrideMode @default(COPY)
  tpValue         Float        @default(0)
  slMode          OverrideMode @default(COPY)
  slValue         Float        @default(0)
  symbolWhitelist String?
  symbolBlacklist String?
  maxDrawdown     Float        @default(0)
  maxSlippage     Float        @default(3)
  status          RuleStatus   @default(ACTIVE)
  copyFactoryStrategyId    String?
  copyFactorySubscriberId  String?
  createdAt       DateTime     @default(now())
  trades          Trade[]

  @@unique([masterAccountId, slaveAccountId])
}

model Trade {
  id             String      @id @default(cuid())
  ruleId         String
  rule           CopyRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  symbol         String
  side           TradeSide
  lots           Float
  openPrice      Float
  closePrice     Float?
  tp             Float?
  sl             Float?
  pnl            Float       @default(0)
  status         TradeStatus @default(OPEN)
  masterTicket   String?
  slaveTicket    String?
  errorMessage   String?
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
}
